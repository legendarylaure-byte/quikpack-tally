rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function memberPath() {
      return /databases/$(database)/documents/companyUsers/quikpack-main/users/$(request.auth.uid);
    }

    function isApprovedMember() {
      return isSignedIn()
        && exists(memberPath())
        && get(memberPath()).data.status == "approved";
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if companyId == "quikpack-main" && (isApprovedMember() || isAdmin());
      allow write: if false;
    }

    match /companyUsers/{companyId}/users/{userId} {
      allow read: if isSignedIn()
        && ((companyId == "quikpack-main" && request.auth.uid == userId) || isAdmin());
      allow write: if false;
    }

    match /catalogue/{itemId} {
      allow read: if isApprovedMember() || isAdmin();
      allow write: if isAdmin();
    }

    match /exchangeRates/{rateId} {
      allow read: if isApprovedMember() || isAdmin();
      allow write: if isAdmin();
    }

    // Business modules are server-owned until their route-level rules are built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
